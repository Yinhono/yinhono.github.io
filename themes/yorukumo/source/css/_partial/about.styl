.about-main
  max-width 800px
  margin 0 auto
  padding 2rem
  text-align center

  .about-title
    font-size 2rem
    font-weight 700
    color var(--text-color)
    margin 0 auto 1rem
    text-align center

  .about-quote
    font-size 1.1rem
    font-weight 400
    font-style italic
    line-height 1.8
    color var(--secondary-text-color)
    max-width 600px
    margin 0 auto 2.5rem
    text-align center

  .about-content
    max-width 720px
    margin 0 auto 3rem
    text-align left
    line-height 1.8
    color var(--text-color)

    p
      margin 0.8rem 0

    ul
      padding-left 1.5rem
      margin 0.8rem 0

    li
      margin 0.3rem 0

    a
      color var(--primary-color)
      text-decoration none

      &:hover
        text-decoration underline

    del
      text-decoration line-through

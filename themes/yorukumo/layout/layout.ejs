<!DOCTYPE html>
<html>
  <%- partial('_partial/head') %>
  <body class="<%- is_home() ? 'is-home' : '' %>">
    <!-- 全站头图（静态横幅，原作者图片）：放在最前面，标题栏透明压在其上 -->
    <div class="site-banner" id="swiper-container">
      <img class="banner-light" src="<%- url_for('/images/banner-light.webp') %>" alt="banner" />
      <img class="banner-dark" src="<%- url_for('/images/banner-dark.webp') %>" alt="banner" />
    </div>
    <div class="body-page-view">
      <%- body %>
    </div>
    <%- partial('_partial/footer') %>
    <%- partial('_widget/to-top') %>
    <%- js(['js/animation.js', 'js/highlight.js', 'js/image-viewer.js']) %>
  </body>
</html>

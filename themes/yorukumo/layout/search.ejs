<!-- 头部 -->
<%- partial('_partial/header',{}, {cache: true}) %>

<!-- 页面内容 -->
<div class="page-content">
  <main class="search-main">
    <div class="search-box">
      <input type="text" id="search-input" placeholder="输入关键词搜索文章…" autocomplete="off" />
    </div>
    <p class="search-count" id="search-count"></p>
    <div class="search-results" id="search-results"></div>
  </main>
</div>

<script>
  (function () {
    var searchXmlUrl = '<%- url_for("search.xml") %>';
    var input = document.getElementById('search-input');
    var resultsEl = document.getElementById('search-results');
    var countEl = document.getElementById('search-count');
    var entries = [];
    var loaded = false;

    function escapeHtml(str) {
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function stripHtml(html) {
      var div = document.createElement('div');
      div.innerHTML = html;
      return div.textContent || '';
    }

    function loadIndex() {
      return fetch(searchXmlUrl)
        .then(function (res) { return res.text(); })
        .then(function (text) {
          var xml = new DOMParser().parseFromString(text, 'text/xml');
          var nodes = xml.getElementsByTagName('entry');
          entries = Array.prototype.map.call(nodes, function (node) {
            var t = node.getElementsByTagName('title')[0];
            var u = node.getElementsByTagName('url')[0];
            var c = node.getElementsByTagName('content')[0];
            return {
              title: t ? t.textContent : '',
              url: u ? u.textContent : '',
              content: c ? stripHtml(c.textContent) : ''
            };
          });
          loaded = true;
        })
        .catch(function () {
          countEl.textContent = '搜索索引加载失败';
        });
    }

    function snippet(text, query) {
      var idx = text.toLowerCase().indexOf(query.toLowerCase());
      if (idx < 0) return text.slice(0, 120);
      var start = Math.max(0, idx - 40);
      return (start > 0 ? '…' : '') + text.slice(start, start + 140) + '…';
    }

    function render(query) {
      var q = query.trim().toLowerCase();
      if (!q) {
        resultsEl.innerHTML = '';
        countEl.textContent = '';
        return;
      }
      var matched = entries.filter(function (e) {
        return e.title.toLowerCase().indexOf(q) !== -1 ||
          e.content.toLowerCase().indexOf(q) !== -1;
      });
      countEl.textContent = '找到 ' + matched.length + ' 篇';
      resultsEl.innerHTML = matched.map(function (e) {
        return '<a class="search-result" href="' + e.url + '">' +
          '<span class="search-result-title">' + escapeHtml(e.title) + '</span>' +
          '<span class="search-result-snippet">' + escapeHtml(snippet(e.content, q)) + '</span>' +
          '</a>';
      }).join('');
    }

    input.addEventListener('input', function () {
      if (!loaded) {
        loadIndex().then(function () { render(input.value); });
      } else {
        render(input.value);
      }
    });

    // 打开页面时如果 URL 带 ?q= 参数，直接搜一次
    var params = new URLSearchParams(window.location.search);
    var q = params.get('q');
    if (q) {
      input.value = q;
      loadIndex().then(function () { render(q); });
    } else {
      loadIndex();
    }
  })();
</script>
